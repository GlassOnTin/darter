<?xml version="1.0" encoding="utf-8"?>
<!-- Hand-rolled refresh-vote plugin for darter's Android build: exposes the
     >=90 Hz window mode vote Godot 4.7.2 does not make itself. Built by
     make_aar.sh into refresh_vote.aar, which addons/refresh_vote loads. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.darter.fro" >
    <application>
        <meta-data
            android:name="org.godotengine.plugin.v2.refresh_vote"
            android:value="org.darter.fro.RefreshVotePlugin" />
    </application>
</manifest>