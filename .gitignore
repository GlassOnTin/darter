/target
*.swp
# the pinned editor binary stays untracked; the checksum list it must be
# verified against is tracked (it comes from Godot's official release)
/tools/godot/*
!/tools/godot/SHA512-SUMS.txt
__pycache__/
/tools/godot_smoke/pack/
/tools/godot_smoke/record/
# regenerable bundle payload (make_bundle.sh); areas/index.json stays tracked
/tools/godot_smoke/areas/*/
/tools/godot_smoke/build/
/tools/godot_smoke/.godot/
/tools/elevation_cache/
